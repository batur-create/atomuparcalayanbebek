{
  "name": "kutup",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node server/index.js --dev",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test tests/core.test.js tests/client.test.js tests/site.test.js tests/push.test.js tests/outbox.test.js tests/node.test.js",
    "test:browser": "python tests/browser_smoke.py",
    "test:worker": "vite build && node --test tests/worker.test.js",
    "test:all": "vite build && node --test tests/*.test.js",
    "worker:dev": "vite build && wrangler dev",
    "deploy": "vite build && wrangler deploy",
    "yayin": "node scripts/yayin.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/manrope": "^5.2.8",
    "lucide-react": "0.468.0",
    "motion": "13.5.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "http_ece": "1.2.1",
    "vite": "6.4.4",
    "wrangler": "4.149.0"
  }
}
