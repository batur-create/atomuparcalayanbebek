# Variables are read from the hosting provider or shell.
# To use a local .env, run: node --env-file=.env server/index.js --dev
PORT=3001
DATA_DIR=./data
# Optional: set a long random secret in your hosting dashboard.
# If omitted, a key is generated in data/batur-key.txt.
# ADMIN_KEY=
# Optional once you have your real HTTPS domain:
# PUBLIC_ORIGIN=https://your-app.example
# VAPID_SUBJECT=mailto:your-contact@example.com
