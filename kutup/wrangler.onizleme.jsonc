{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Preview only (claude/onizleme-hepsi): the same app as a separate Worker
  // with its own empty D1 database, so trying the open PRs never touches the
  // live site or its data. Deploy with `npm run onizleme`; remove with
  // `npx wrangler delete --name kutup-onizleme`.
  "name": "kutup-onizleme",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "triggers": { "crons": ["* * * * *"] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "kutup-onizleme" }],
  "durable_objects": { "bindings": [{ "name": "LIVE", "class_name": "LiveRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveRoom"] }],
  "observability": { "enabled": true }
}
