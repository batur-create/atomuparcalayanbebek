{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kutup",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "triggers": { "crons": ["* * * * *"] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The Worker supplies the SPA shell for known document routes and a real
    // 404 shell for unknown ones. Missing scripts/images must remain 404.
    "not_found_handling": "none",
    // HTML routes need the shared route contract (404 and private-page noindex).
    // Scripts, fonts and images stay on the asset path without Worker execution.
    "run_worker_first": [
      "/*", "!/assets/*", "!/icon.svg", "!/icon-*.png",
      "!/apple-touch-icon.png", "!/badge-96.png", "!/mode.js",
      "!/sw.js", "!/manifest.webmanifest"
    ]
  },
  // No database_id: `wrangler deploy` creates the D1 database on first deploy
  // and `wrangler dev` creates a local one automatically.
  "d1_databases": [{ "binding": "DB", "database_name": "kutup" }],
  // n29: one LiveRoom per team pushes "changed" to open phones over hibernating
  // WebSockets. SQLite-backed classes run on the Workers free plan.
  "durable_objects": { "bindings": [{ "name": "LIVE", "class_name": "LiveRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveRoom"] }],
  "observability": { "enabled": true }
}
